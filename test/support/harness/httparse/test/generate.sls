;;; (httparse test generate): deterministic input generation for the property
;;; and differential lanes.
;;;
;;; WHY A GENERATOR AT ALL. The vendored corpus is the conformance oracle and
;;; it is replayed at every chunk size, so resumability and the recorded traces
;;; are already covered. What no recorded trace can cover is an input nobody
;;; wrote down -- decision 0010 is explicit that this is the one thing a live
;;; llhttp adds. So this module exists to produce inputs the corpus does not
;;; contain, reproducibly: a seed names a run, and a failing run replays byte
;;; for byte.
;;;
;;; EVERY GENERATED BYTE IS IN [1,127], AND THAT IS A LIMIT, NOT AN OVERSIGHT.
;;; The live oracle is llhttp's own fixture binary, which takes its input as an
;;; argv string (llparse-test-fixture's `main`), so a NUL cannot reach it at
;;; all and a byte above 0x7f reaches it UTF-8 encoded -- two bytes where the
;;; generator meant one, which would compare a different input on each side.
;;; Upstream's own corpus shows this: its six non-ASCII fixtures record
;;; `len=2` for one character. So obs-text and NUL are covered by the corpus
;;; and not by this generator, and `generate-safe-byte?` is asserted over the
;;; output rather than described in a comment.
;;;
;;; THE STATE IS THREADED, NEVER HIDDEN. Every producer takes a PRNG state and
;;; returns the next one beside its value, so a case list is a pure function of
;;; its seed and nothing about a run depends on the order lanes happen to call
;;; things in.
(library (httparse test generate)
  (export make-gen-case gen-case? gen-case-kind gen-case-bytes gen-case-origin
          generate-safe-byte? generate-safe-bytes?
          generate-structured generate-mutants generate-urls
          ;; exported so the mutation table is judged on exact bytes rather
          ;; than through a whole generated run
          generate-mutate generate-mutations
          generate-error? generate-error-detail)
  (import (rnrs) (httparse test prng))

  (define-condition-type &generate &error
    make-generate-error generate-error? (detail generate-error-detail))

  (define (refuse who detail)
    (raise (condition (make-generate-error detail)
                      (make-who-condition who)
                      (make-message-condition detail))))

  ;; A case is an input plus the two things a failure report needs: which
  ;; parser kind it is meant for, and where it came from.
  (define-record-type gen-case (fields kind bytes origin))

  ;; generate-safe-byte? : Nat -> Boolean
  (define (generate-safe-byte? b) (and (>= b 1) (<= b 127)))

  ;; generate-safe-bytes? : Bytevector -> Boolean
  (define (generate-safe-bytes? bv)
    (let loop ((i 0))
      (cond ((= i (bytevector-length bv)) #t)
            ((generate-safe-byte? (bytevector-u8-ref bv i)) (loop (+ i 1)))
            (else #f))))

  ;; --- plumbing -------------------------------------------------------------

  (define (pick s items)
    (let-values (((k s2) (prng-next s (length items))))
      (values (list-ref items k) s2)))

  ;; Returns #t with probability n/d.
  (define (chance s n d)
    (let-values (((k s2) (prng-next s d)))
      (values (< k n) s2)))

  (define (str . parts) (apply string-append parts))

  (define (num->string n) (number->string n))

  ;; --- the structured message generator -------------------------------------
  ;;
  ;; The pools are chosen for what they make the parser DECIDE, not for
  ;; realism: framing headers that disagree, versions the strict grammar
  ;; rejects, status codes whose bodies llhttp treats specially, and targets
  ;; that reach different arms of the request-line dispatch.

  (define methods
    '("GET" "POST" "PUT" "DELETE" "HEAD" "OPTIONS" "CONNECT" "PATCH"
      "M-SEARCH" "PROPFIND" "SOURCE" "GXT" "get" "TRACE"))

  (define targets
    '("/" "/a/b" "/x?y=1" "*" "http://h/p" "a.com:443" "/%41" "/a#f" "//x"
      "/very/long/path/segment/that/keeps/going"))

  (define versions '("1.1" "1.0" "0.9" "2.0" "1.9" "1." "11.1" "1.11"))

  (define protocols '("HTTP" "RTSP" "ICE" "HTTZ"))

  (define status-codes '(100 101 102 103 200 201 204 301 304 400 404 500 999 7 1234))

  (define reasons '("OK" "Not Found" "" "Switching Protocols" "No Content"))

  (define (request-line s)
    (let*-values (((m s) (pick s methods))
                  ((t s) (pick s targets))
                  ((p s) (pick s protocols))
                  ((v s) (pick s versions)))
      (values (str m " " t " " p "/" v "\r\n") s)))

  (define (status-line s)
    (let*-values (((p s) (pick s protocols))
                  ((v s) (pick s versions))
                  ((c s) (pick s status-codes))
                  ((r s) (pick s reasons)))
      (values (str p "/" v " " (num->string c) (if (string=? r "") "" (str " " r)) "\r\n")
              s)))

  ;; A framing choice is made once and then honoured by the body, so a
  ;; generated message is usually well framed -- the interesting failures are
  ;; the ones the parser finds, not the ones the generator built in.
  (define framings '(none length chunked both te-identity))

  (define (framing-headers framing s)
    (case framing
      ((none) (values '() s))
      ((length)
       (let-values (((n s) (pick s '(0 1 5 13 100))))
         (values (list (cons "Content-Length" (num->string n))) s)))
      ((chunked) (values (list (cons "Transfer-Encoding" "chunked")) s))
      ((both) (values (list (cons "Content-Length" "5")
                            (cons "Transfer-Encoding" "chunked")) s))
      ((te-identity)
       (let-values (((v s) (pick s '("identity" "gzip" "chunked, gzip" "gzip, chunked"))))
         (values (list (cons "Transfer-Encoding" v)) s)))
      (else (refuse 'framing-headers "unknown framing"))))

  (define other-headers
    '(("Host" . "example.com")
      ("Connection" . "keep-alive")
      ("Connection" . "close")
      ("Connection" . "upgrade")
      ("Connection" . "keep-alive, upgrade")
      ("Upgrade" . "websocket")
      ("X-Foo" . "bar")
      ("Trailer" . "X-T")
      ("Accept" . "*/*")
      ("Empty" . "")
      ("Ws" . "  padded  ")))

  (define (extra-headers s)
    (let-values (((n s) (prng-next s 4)))
      (let loop ((i 0) (s s) (acc '()))
        (if (= i n)
            (values (reverse acc) s)
            (let-values (((h s2) (pick s other-headers)))
              (loop (+ i 1) s2 (cons h acc)))))))

  ;; Separator noise is where strict mode earns its name: llhttp accepts
  ;; `Name:value` and `Name:\tvalue` and rejects a space before the colon.
  (define (render-header h s)
    (let-values (((sep s) (pick s '(": " ":" ":\t" ":  " " : "))))
      (values (str (car h) sep (cdr h) "\r\n") s)))

  (define (render-headers hs s)
    (let loop ((hs hs) (s s) (acc '()))
      (if (null? hs)
          (values (apply str (reverse acc)) s)
          (let-values (((t s2) (render-header (car hs) s)))
            (loop (cdr hs) s2 (cons t acc))))))

  (define (filler n)
    (let loop ((i 0) (acc '()))
      (if (= i n) (apply str (reverse acc)) (loop (+ i 1) (cons "x" acc)))))

  (define (chunk-body s)
    (let*-values (((count s) (prng-next s 3))
                  ((ext s) (chance s 1 4)))
      (let loop ((i 0) (s s) (acc '()))
        (if (= i count)
            (let-values (((trailer s2) (chance s 1 4)))
              (values (apply str (reverse (cons (if trailer "0\r\nX-T: v\r\n\r\n" "0\r\n\r\n")
                                                acc)))
                      s2))
            (let-values (((n s2) (pick s '(1 3 10))))
              (loop (+ i 1) s2
                    (cons (str (number->string n 16)
                               (if ext ";a=b" "")
                               "\r\n" (filler n) "\r\n")
                          acc)))))))

  (define (body-for framing headers s)
    (case framing
      ((chunked both) (chunk-body s))
      ((length)
       (let ((cl (cond ((assoc "Content-Length" headers) => cdr) (else "0"))))
         (values (filler (string->number cl)) s)))
      (else (values "" s))))

  ;; generate-structured : Nat Nat -> (Listof GenCase)
  ;; `count` assembled messages from `seed`. Both kinds appear; roughly a
  ;; sixth are truncated mid-message, which is where a resumable parser's
  ;; offsets are most likely to disagree with llhttp's.
  (define (generate-structured seed count)
    (let loop ((i 0) (s (make-prng seed)) (acc '()))
      (if (= i count)
          (reverse acc)
          (let*-values (((response? s) (chance s 1 2))
                        ((start s) (if response? (status-line s) (request-line s)))
                        ((framing s) (pick s framings))
                        ((fh s) (framing-headers framing s))
                        ((eh s) (extra-headers s))
                        ((head s) (render-headers (append fh eh) s))
                        ((body s) (body-for framing fh s))
                        ((truncate? s) (chance s 1 6))
                        ((text) (str start head "\r\n" body))
                        ((cut s) (if truncate?
                                     (prng-next s (max 1 (string-length text)))
                                     (values (string-length text) s))))
            (let* ((kept (substring text 0 (min cut (string-length text))))
                   (bv (string->utf8 kept)))
              (loop (+ i 1) s
                    (cons (make-gen-case
                           (if response? 'response 'request)
                           bv
                           (str "structured seed=" (num->string seed)
                                " n=" (num->string i)
                                " framing=" (symbol->string framing)
                                (if truncate? (str " cut=" (num->string cut)) "")))
                          acc)))))))

  ;; --- the url generator ----------------------------------------------------
  ;;
  ;; WHY A SECOND PRODUCER AND NOT A WIDER TARGET POOL. Decision 0022 makes
  ;; the url sub-parser a SECOND MACHINE and decision 0023 splices it into the
  ;; request target, so `generate-structured` does reach it -- through one
  ;; field out of ten, from a pool of ten fixed strings, always followed by a
  ;; space and a version. Its entry edges are covered and its error arms are
  ;; not, because a message whose target is rejected never gets to the rest of
  ;; the message and the generator has no reason to keep producing them.
  ;;
  ;; THE ORACLE FOR THIS KIND IS A DIFFERENT BINARY. `test/md-test.ts`'s
  ;; `buildURL()` is `new llhttp.URL(p, true)` with BOTH EXITS LOOPED BACK TO
  ;; THE ENTRY, which is the binary `url.md` was recorded from and the one
  ;; `make-url-machine` is built for. The loop is why a separator below is a
  ;; graph edge rather than a terminator: a space does not end the parse, it
  ;; starts another url.
  ;;
  ;; THE POOLS ARE llhttp'S OWN DECISION POINTS, read off `src/llhttp/url.ts`
  ;; -- wherever a node has more than one edge, both sides of it appear here.
  ;; That is why the malformed spellings sit beside the well-formed ones:
  ;; `:/`, `@@` and a byte URL_CHAR does not contain are the only way to reach
  ;; the error arms, and an error arm is where an offset is easiest to get
  ;; wrong. They are INPUTS, not expectations -- what the two parsers should
  ;; print for them is the oracle's business.

  (define url-schemas '("http" "https" "a" "HTTP" "x1" "a-b" "h2c"))

  ;; `schema_delim` matches the PAIR `//`, so a mismatch after one byte leaves
  ;; that byte consumed. That is the whole of `url.md`'s "Failing on broken
  ;; schema", and the one offset in this machine a plausible implementation
  ;; gets wrong while passing everything else.
  (define url-delims '("://" ":/" ":" ":x/" "//"))

  ;; `<` is in neither USERINFO_CHARS nor the bracket pair, so `host<com`
  ;; reaches `Unexpected char in url server`; `a@b@c` reaches `Double @`.
  (define url-authorities
    '("host.com" "host.com:8080" "[1:2::3:4]" "[fe80::a%25eth0]:67"
      "a:b@host.com" "a%20:b@host.com" "a!;-_!=+$@host.com" "a@b@c"
      "" "host<com"))

  ;; DEL and the C0 bytes are URL_CHAR's complement inside [1,127] once the
  ;; separators are taken out, so they are how `Invalid char in url path`,
  ;; `... url query` and `... url fragment start` are reached.
  (define url-paths
    '("" "/" "/p" "/p/q" "/a.b" "/%41" "/p(q)" "/p[q]" "/p|q" "*"
      "/\x7f;" "/p\x01;q"))

  (define url-queries '("" "?" "?q=1" "?a=1?b=2" "?x%20y" "?a&b=c" "?p\x7f;q"))

  (define url-fragments '("" "#" "#f" "#a?b" "#a#b" "#f\x01;g"))

  ;; What sits between two urls. The first four are the exits upstream builds;
  ;; `cr` reaches `Expected CRLF` when no LF follows, and the last two reach
  ;; `Invalid characters in url` through the wrapper every node carries.
  (define url-separators
    '((none . "") (space . " ") (crlf . "\r\n") (lf . "\n")
      (cr . "\r") (tab . "\t") (ff . "\x0c;")))

  ;; url-piece : PRNG -> (values String Char PRNG)
  ;; One url and the letter its form is named by in the origin.
  (define (url-piece s)
    (let-values (((absolute? s) (chance s 1 2)))
      (if absolute?
          (let*-values (((sc s) (pick s url-schemas))
                        ((d s) (pick s url-delims))
                        ((a s) (pick s url-authorities))
                        ((p s) (pick s url-paths))
                        ((q s) (pick s url-queries))
                        ((f s) (pick s url-fragments)))
            (values (str sc d a p q f) #\a s))
          (let*-values (((p s) (pick s url-paths))
                        ((q s) (pick s url-queries))
                        ((f s) (pick s url-fragments)))
            (values (str p q f) #\r s)))))

  ;; generate-urls : Nat Nat -> (Listof GenCase)
  ;; `count` inputs from `seed`, every one of kind `url`. An input holds one
  ;; to three urls joined by one separator, sometimes with that separator
  ;; trailing, and roughly a sixth are cut short -- the same truncation arm
  ;; the message generator has, and for the same reason.
  ;;
  ;; AN EMPTY INPUT IS NEVER EMITTED. Every pool has an empty member and a
  ;; relative url is three of them, so the assembly can come out with no bytes
  ;; at all; a zero-length case would compare nothing and read as a pass.
  (define (generate-urls seed count)
    (let loop ((i 0) (s (make-prng seed)) (acc '()))
      (if (= i count)
          (reverse acc)
          (let*-values (((extra s) (prng-next s 3))
                        ((sep s) (pick s url-separators))
                        ((trailing? s) (chance s 1 3)))
            (let build ((k 0) (s s) (parts '()) (forms '()))
              (if (<= k extra)
                  (let-values (((piece form s2) (url-piece s)))
                    (build (+ k 1) s2 (cons piece parts) (cons form forms)))
                  (let* ((sep-text (cdr sep))
                         (joined (let join ((ps (reverse parts)) (out ""))
                                   (cond ((null? ps) out)
                                         ((string=? out "") (join (cdr ps) (car ps)))
                                         (else (join (cdr ps) (str out sep-text (car ps)))))))
                         (text (str joined (if trailing? sep-text "")))
                         ;; The fallback is a url and not padding: `/` is the
                         ;; shortest input that opens a span at all.
                         (text (if (string=? text "") "/" text)))
                    (let*-values (((cut? s) (chance s 1 6))
                                  ((cut s) (if cut?
                                               (prng-next s (string-length text))
                                               (values (string-length text) s))))
                      (let* ((kept (substring text 0 (max 1 cut)))
                             (bv (string->utf8 kept)))
                        (loop (+ i 1) s
                              (cons (make-gen-case
                                     'url bv
                                     (str "url seed=" (num->string seed)
                                          " n=" (num->string i)
                                          " urls=" (num->string (+ extra 1))
                                          " sep=" (symbol->string (car sep))
                                          " forms=" (list->string (reverse forms))
                                          (if (and cut? (< (max 1 cut) (string-length text)))
                                              (str " cut=" (num->string (max 1 cut)))
                                              "")))
                                    acc)))))))))))

  ;; --- the mutation generator -----------------------------------------------
  ;;
  ;; A corpus input with one byte changed is the cheapest way to reach the
  ;; neighbourhood of a real message, which is where the grammar's arms are
  ;; densest. The base keeps its kind: a mutated request is still parsed as a
  ;; request, because that is what the embedder would have told the parser.

  (define generate-mutations '(substitute delete insert truncate swap duplicate))

  (define (bv-list bv) (bytevector->u8-list bv))
  (define (list-bv xs) (u8-list->bytevector xs))

  (define (generate-mutate op bv at byte)
    (let ((xs (bv-list bv)) (n (bytevector-length bv)))
      (define (splice before after) (list-bv (append before after)))
      (define (take-n xs k) (if (or (= k 0) (null? xs)) '() (cons (car xs) (take-n (cdr xs) (- k 1)))))
      (define (drop-n xs k) (if (or (= k 0) (null? xs)) xs (drop-n (cdr xs) (- k 1))))
      (case op
        ((substitute) (splice (take-n xs at) (cons byte (drop-n xs (+ at 1)))))
        ((delete) (splice (take-n xs at) (drop-n xs (+ at 1))))
        ((insert) (splice (take-n xs at) (cons byte (drop-n xs at))))
        ((truncate) (splice (take-n xs at) '()))
        ((swap) (if (>= (+ at 1) n)
                    bv
                    (splice (take-n xs at)
                            (cons (list-ref xs (+ at 1))
                                  (cons (list-ref xs at) (drop-n xs (+ at 2)))))))
        ((duplicate) (splice (take-n xs (+ at 1)) (drop-n xs at)))
        (else (refuse 'generate-mutate "unknown mutation")))))

  ;; generate-mutants : Nat Nat (Listof (Pair Symbol (Pair String Bytevector)))
  ;;                    -> (Listof GenCase)
  ;; Each base is `(kind name . bytes)`. A base carrying a byte this generator
  ;; may not emit is REFUSED rather than quietly skipped: it would produce
  ;; mutants the oracle cannot be given, and a silently shorter run is the
  ;; shape of evidence that is not there.
  (define (generate-mutants seed count bases)
    (when (null? bases) (refuse 'generate-mutants "no bases to mutate"))
    (for-each
     (lambda (b)
       (unless (generate-safe-bytes? (cddr b))
         (refuse 'generate-mutants
                 (str "base " (cadr b) " carries a byte outside [1,127]"))))
     bases)
    (let loop ((i 0) (s (make-prng seed)) (acc '()))
      (if (= i count)
          (reverse acc)
          (let*-values (((base s) (pick s bases))
                        ((op s) (pick s generate-mutations))
                        ((len) (bytevector-length (cddr base)))
                        ((at s) (prng-next s (max 1 len)))
                        ((byte s) (prng-next s 127)))
            (let ((bv (generate-mutate op (cddr base) at (+ byte 1))))
              (loop (+ i 1) s
                    (cons (make-gen-case
                           (car base) bv
                           (str "mutant seed=" (num->string seed)
                                " n=" (num->string i)
                                " base=" (cadr base)
                                " " (symbol->string op) "@" (num->string at)))
                          acc))))))))
