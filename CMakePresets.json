{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 26,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Development (tests on)",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "HTTPARSE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "prod",
      "displayName": "Production (tests on)",
      "binaryDir": "${sourceDir}/build/prod",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "HTTPARSE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "no-scheme",
      "displayName": "CMake-layer specifications only (no Scheme runtime required)",
      "binaryDir": "${sourceDir}/build/no-scheme",
      "cacheVariables": {
        "HTTPARSE_BUILD_TESTS": "ON",
        "HTTPARSE_REQUIRE_CHEZ": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "configuration": "Debug"
    },
    {
      "name": "prod",
      "configurePreset": "prod",
      "configuration": "Release"
    },
    {
      "name": "no-scheme",
      "configurePreset": "no-scheme",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "harness",
      "displayName": "Harness and build-layer self-tests only",
      "configurePreset": "dev",
      "filter": {
        "include": {
          "label": "^harness$"
        }
      },
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "${sourceDir}/build/dev/test-results/harness.xml"
      },
      "configuration": "Debug",
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "pr",
      "displayName": "Pull-request selection",
      "configurePreset": "dev",
      "filter": {
        "include": {
          "label": "^(harness|unit|verify|differential|property|determinism|conformance|portability|example|docs)$"
        },
        "exclude": {
          "label": "^full-scan$"
        }
      },
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "${sourceDir}/build/dev/test-results/pr.xml"
      },
      "configuration": "Debug",
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "release",
      "displayName": "Complete selection",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "${sourceDir}/build/dev/test-results/release.xml"
      },
      "configuration": "Debug",
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "no-scheme",
      "displayName": "CMake-layer specifications only",
      "configurePreset": "no-scheme",
      "output": {
        "outputOnFailure": true,
        "outputJUnitFile": "${sourceDir}/build/no-scheme/test-results/no-scheme.xml"
      },
      "configuration": "Debug",
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
